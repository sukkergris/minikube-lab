{
    "name": "minikube-lab",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev",
    "workspaceFolder": "/xyz",
    "shutdownAction": "stopCompose",
    "remoteUser": "container-user",
    "features":  {
        "ghcr.io/devcontainers/features/docker-in-docker": {
            "moby":"false"
        }
    },
    "postCreateCommand": "bash .devcontainer/scripts/post-create.sh"
}