{
    "cSpell.language": "en,da",
    "cSpell.ignoreWords": [
        "NOPASSWD",
        "sshtemplate"
    ],
    "cSpell.words": [
        "claude",
        "debian",
        "devcontaineren",
        "devcontainers",
        "Dockerfilen",
        "dotnet",
        "dpkg",
        "moby",
        "nginx",
        "noninteractive",
        "openssh",
        "theo"
    ],
    "dotfiles.repository": "git@github.com:sukkergris/devcontainer-dotfiles.git",
    "dotfiles.targetPath": "~/dotfiles",
    "dotfiles.installCommand": ".install.sh",
    "vim.leader": "<space>",
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<leader>",
                "p"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ]
        },
        {
            "before": [
                "<leader>",
                "n"
            ],
            "commands": [
                "explorer.newFile"
            ]
        }
    ]
}